+#[derive(Default)]
+struct TestHost {
+    attached: AtomicBool,
+    decline: AtomicBool,
+    fail_once: AtomicBool,
+    messages: StdMutex<Vec<String>>,
+    failures: StdMutex<Vec<String>>,
+    hold_owner: AtomicBool,
+    owner_entered: tokio::sync::Notify,
+    owner_release: tokio::sync::Notify,
+    hold_delivery: AtomicBool,
+    admission_guards: StdMutex<Vec<Arc<AtomicBool>>>,
+}
