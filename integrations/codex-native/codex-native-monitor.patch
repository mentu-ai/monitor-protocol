@@ -0,0 +1,344 @@
+//! Native monitor integration against local, canned Responses and Monitor Protocol servers.
+//! These tests never call a real model or use a user's provider credentials.
+
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+
+use anyhow::Context;
+use anyhow::Result;
+use app_test_support::MockResponsesConfig;
+use app_test_support::TestAppServer;
+use codex_app_server_protocol::ClientRequest;
+use codex_app_server_protocol::ThreadLoadedListParams;
+use codex_app_server_protocol::ThreadLoadedListResponse;
+use codex_app_server_protocol::ThreadStartParams;
+use codex_app_server_protocol::ThreadUnsubscribeParams;
+use codex_app_server_protocol::ThreadUnsubscribeResponse;
+use codex_app_server_protocol::ThreadUnsubscribeStatus;
+use codex_app_server_protocol::TurnCompletedNotification;
+use codex_app_server_protocol::TurnStartParams;
+use codex_app_server_protocol::UserInput;
+use core_test_support::responses;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+use tempfile::TempDir;
+use tokio::time::sleep;
+use tokio::time::timeout;
+use wiremock::Mock;
+use wiremock::MockServer;
+use wiremock::Request;
+use wiremock::ResponseTemplate;
+use wiremock::matchers::header;
+use wiremock::matchers::method;
+use wiremock::matchers::path;
+use wiremock::matchers::path_regex;
+
+const READ_TIMEOUT: Duration = Duration::from_secs(15);
+const TOKEN_ENV: &str = "CODEX_NATIVE_MONITOR_TEST_TOKEN";
+const TEST_TOKEN: &str = "native-monitor-fixture-token";
+const PAYLOAD_SENTINEL: &str = "untrusted-payload-sentinel";
+
+struct ProtocolFixture {
+    server: MockServer,
+    published: Arc<AtomicBool>,
+    acknowledgements: Arc<AtomicUsize>,
+    pulls: Arc<AtomicUsize>,
+}
+
+impl ProtocolFixture {
+    async fn start() -> Self {
+        let server = MockServer::start().await;
+        let published = Arc::new(AtomicBool::new(false));
+        let acknowledgements = Arc::new(AtomicUsize::new(0));
+        let pulls = Arc::new(AtomicUsize::new(0));
+        let pulls_for_request = Arc::clone(&pulls);
+        let published_for_pull = Arc::clone(&published);
+        let acknowledgements_for_pull = Arc::clone(&acknowledgements);
+        Mock::given(method("GET"))
+            .and(path("/mp/v0/subscriptions/native-test/pull"))
+            .and(header("authorization", format!("Bearer {TEST_TOKEN}")))
+            .respond_with(move |_request: &Request| {
+                pulls_for_request.fetch_add(1, Ordering::SeqCst);
+                let acked = acknowledgements_for_pull.load(Ordering::SeqCst) > 0;
+                let has_event = published_for_pull.load(Ordering::SeqCst);
+                let cursor = if acked { 2 } else { 1 };
+                let observations = if has_event && !acked {
+                    vec![json!({
+                        "specversion": "1.0",
+                        "source": "monitor:native-test",
+                        "id": "00000000000000000001",
+                        "sequence": "00000000000000000001",
+                        "type": "com.example.changed",
+                        "time": "2026-10-11T00:00:00Z",
+                        "tier": "measured",
+                        "origin": "probe",
+                        "verified": "machine_verified",
+                        "horizon": "event",
+                        "actor": "system:test",
+                        "data": {
+                            "ref": "test:event:1",
+                            "value": PAYLOAD_SENTINEL,
+                            "provenance": {
+                                "tier": "measured",
+                                "origin": "probe",
+                                "verification": "machine_verified",
+                                "actor": "system:test"
+                            }
+                        }
+                    })]
+                } else {
+                    Vec::new()
+                };
+                ResponseTemplate::new(200).set_body_json(json!({
+                    "subscription": "native-test",
+                    "cursor": cursor,
+                    "next": if has_event { 2 } else { cursor },
+                    "head": usize::from(has_event),
+                    "retention_floor": 1,
+                    "observations": observations
+                }))
+            })
+            .mount(&server)
+            .await;
+        let acknowledgements_for_ack = Arc::clone(&acknowledgements);
+        Mock::given(method("POST"))
+            .and(path("/mp/v0/subscriptions/native-test/ack"))
+            .and(header("authorization", format!("Bearer {TEST_TOKEN}")))
+            .respond_with(move |request: &Request| {
+                assert_eq!(request.body_json::<Value>().unwrap(), json!({"cursor": 2}));
+                acknowledgements_for_ack.fetch_add(1, Ordering::SeqCst);
+                ResponseTemplate::new(200)
+                    .set_body_json(json!({"subscription": "native-test", "cursor": 2}))
+            })
+            .mount(&server)
+            .await;
+        Self {
+            server,
+            published,
+            acknowledgements,
+            pulls,
+        }
+    }
+
+    fn start_arguments(&self) -> Value {
+        json!({"source": "fixture"})
+    }
+}
+
+fn tool_response(id: &str, name: &str, arguments: Value) -> String {
+    responses::sse(vec![
+        responses::ev_response_created(id),
+        responses::ev_function_call(id, name, &arguments.to_string()),
+        responses::ev_completed(id),
+    ])
+}
+
+fn completed_response(id: &str) -> String {
+    responses::sse(vec![
+        responses::ev_response_created(id),
+        responses::ev_assistant_message(id, "done"),
+        responses::ev_completed(id),
+    ])
+}
+
+/// Standalone function outputs can be represented as a string or content parts.
+fn observation_in(value: &Value) -> Option<Value> {
+    match value {
+        Value::Object(fields) => {
+            if fields.get("type").and_then(Value::as_str) == Some("monitor_observation") {
+                return Some(value.clone());
+            }
+            fields.values().find_map(observation_in)
+        }
+        Value::Array(items) => items.iter().find_map(observation_in),
+        Value::String(text) => serde_json::from_str::<Value>(text)
+            .ok()
+            .and_then(|parsed| observation_in(&parsed)),
+        _ => None,
+    }
+}
+
+async fn start_app(
+    server: &MockServer,
+    protocol: &ProtocolFixture,
+) -> Result<(TestAppServer, TempDir)> {
+    let codex_home = TempDir::new()?;
+    MockResponsesConfig::new(&server.uri())
+        .with_root_config("thread_unload_delay_secs = 60")
+        .write(codex_home.path())?;
+    std::fs::create_dir(codex_home.path().join("native-monitors"))?;
+    std::fs::write(
+        codex_home.path().join("native-monitors/sources.json"),
+        serde_json::to_vec(&json!({"fixture": {
+            "base_url": protocol.server.uri(),
+            "subscription": "native-test",
+            "token_env": TOKEN_ENV
+        }}))?,
+    )?;
+    let app = TestAppServer::builder()
+        .with_codex_home(codex_home.path())
+        .with_env_overrides(&[(TOKEN_ENV, Some(TEST_TOKEN))])
+        .without_managed_config()
+        .build_initialized()
+        .await?;
+    Ok((app, codex_home))
+}
+
+async fn arm_in_turn(app: &mut TestAppServer) -> Result<String> {
+    let thread = app
+        .start_thread(ThreadStartParams {
+            model: Some("mock-model".to_string()),
+            ..Default::default()
+        })
+        .await?
+        .thread;
+    timeout(
+        READ_TIMEOUT,
+        app.start_turn_and_wait_for_completion(TurnStartParams {
+            thread_id: thread.id.clone(),
+            input: vec![UserInput::Text {
+                text: "Arm the explicitly authorized test subscription for this open session."
+                    .to_string(),
+                text_elements: Vec::new(),
+            }],
+            ..Default::default()
+        }),
+    )
+    .await??;
+    Ok(thread.id)
+}
+
+#[tokio::test]
+async fn native_monitor_wakes_idle_thread_and_acks_only_after_handled() -> Result<()> {
+    let protocol = ProtocolFixture::start().await;
+    let server = responses::start_mock_server().await;
+    let requests = Arc::new(AtomicUsize::new(0));
+    let observation = Arc::new(Mutex::new(None::<Value>));
+    let requests_for_model = Arc::clone(&requests);
+    let observation_for_model = Arc::clone(&observation);
+    let acknowledgements = Arc::clone(&protocol.acknowledgements);
+    let start_arguments = protocol.start_arguments();
+    Mock::given(method("POST"))
+        .and(path_regex(".*/responses"))
+        .respond_with(move |request: &Request| {
+            let body: Value = request.body_json().unwrap();
+            assert!(!body.to_string().contains(TEST_TOKEN));
+            let response = match requests_for_model.fetch_add(1, Ordering::SeqCst) {
+                0 => tool_response("arm", "monitor_start", start_arguments.clone()),
+                1 => completed_response("armed"),
+                2 => {
+                    assert_eq!(acknowledgements.load(Ordering::SeqCst), 0);
+                    assert!(!body.to_string().contains(PAYLOAD_SENTINEL));
+                    let metadata = observation_in(&body["input"])
+                        .expect("idle turn contains native observation metadata");
+                    let arguments = json!({
+                        "monitor_id": metadata["monitor_id"],
+                        "delivery": metadata["delivery"]
+                    });
+                    *observation_for_model.lock().unwrap() = Some(metadata);
+                    tool_response("inspect", "monitor_show", arguments)
+                }
+                3 => {
+                    assert_eq!(acknowledgements.load(Ordering::SeqCst), 0);
+                    assert!(body.to_string().contains(PAYLOAD_SENTINEL));
+                    let metadata = observation_for_model.lock().unwrap();
+                    let metadata = metadata.as_ref().unwrap();
+                    tool_response(
+                        "handled",
+                        "monitor_handled",
+                        json!({
+                            "monitor_id": metadata["monitor_id"],
+                            "delivery": metadata["delivery"],
+                            "evidence": "test:disposition:1"
+                        }),
+                    )
+                }
+                4 => completed_response("observed"),
+                other => panic!("unexpected model request after bounded monitor exchange: {other}"),
+            };
+            ResponseTemplate::new(200)
+                .insert_header("content-type", "text/event-stream")
+                .set_body_string(response)
+        })
+        .mount(&server)
+        .await;
+    let (mut app, _codex_home) = start_app(&server, &protocol).await?;
+    let thread_id = arm_in_turn(&mut app).await?;
+    assert_eq!(requests.load(Ordering::SeqCst), 2);
+    assert_eq!(protocol.acknowledgements.load(Ordering::SeqCst), 0);
+
+    // The source becomes observable only after the receiver's first turn completed.
+    protocol.published.store(true, Ordering::SeqCst);
+    let completed: TurnCompletedNotification =
+        timeout(READ_TIMEOUT, app.read_notification("turn/completed")).await??;
+    assert_eq!(completed.thread_id, thread_id);
+    timeout(READ_TIMEOUT, async {
+        while protocol.acknowledgements.load(Ordering::SeqCst) == 0 {
+            sleep(Duration::from_millis(20)).await;
+        }
+    })
+    .await
+    .context("handled disposition did not advance the subscription")?;
+    assert_eq!(requests.load(Ordering::SeqCst), 5);
+    assert_eq!(protocol.acknowledgements.load(Ordering::SeqCst), 1);
+    Ok(())
+}
+
+#[tokio::test]
+async fn native_monitor_unsubscribe_stops_delivery_while_thread_stays_loaded() -> Result<()> {
+    let protocol = ProtocolFixture::start().await;
+    let server = responses::start_mock_server().await;
+    let requests = Arc::new(AtomicUsize::new(0));
+    let requests_for_model = Arc::clone(&requests);
+    let start_arguments = protocol.start_arguments();
+    Mock::given(method("POST"))
+        .and(path_regex(".*/responses"))
+        .respond_with(move |_request: &Request| {
+            let response = match requests_for_model.fetch_add(1, Ordering::SeqCst) {
+                0 => tool_response("arm", "monitor_start", start_arguments.clone()),
+                1 => completed_response("armed"),
+                other => panic!("monitor woke an unsubscribed owner: request {other}"),
+            };
+            ResponseTemplate::new(200)
+                .insert_header("content-type", "text/event-stream")
+                .set_body_string(response)
+        })
+        .mount(&server)
+        .await;
+    let (mut app, _codex_home) = start_app(&server, &protocol).await?;
+    let thread_id = arm_in_turn(&mut app).await?;
+    let unsubscribed: ThreadUnsubscribeResponse = app
+        .request(|request_id| ClientRequest::ThreadUnsubscribe {
+            request_id,
+            params: ThreadUnsubscribeParams {
+                thread_id: thread_id.clone(),
+            },
+        })
+        .await?;
+    assert_eq!(unsubscribed.status, ThreadUnsubscribeStatus::Unsubscribed);
+    let loaded: ThreadLoadedListResponse = app
+        .request(|request_id| ClientRequest::ThreadLoadedList {
+            request_id,
+            params: ThreadLoadedListParams::default(),
+        })
+        .await?;
+    assert!(loaded.data.contains(&thread_id));
+
+    let pulls_after_unsubscribe = protocol.pulls.load(Ordering::SeqCst);
+    protocol.published.store(true, Ordering::SeqCst);
+    // Inspect actual source/model traffic. The test client preserves historical
+    // turn/started notifications, which are not evidence of a new wake.
+    sleep(Duration::from_secs(2)).await;
+    assert_eq!(
+        protocol.pulls.load(Ordering::SeqCst),
+        pulls_after_unsubscribe
+    );
+    assert_eq!(requests.load(Ordering::SeqCst), 2);
+    assert_eq!(protocol.acknowledgements.load(Ordering::SeqCst), 0);
+    Ok(())
+}
