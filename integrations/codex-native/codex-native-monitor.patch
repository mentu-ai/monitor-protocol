index 0000000000000000000000000000000000000000..dbb7d295eb43ecb887cd9421a2a50b6e3dd3d066
--- /dev/null
+++ b/codex-rs/app-server/src/native_monitor.rs
@@ -0,0 +1,336 @@
+//! Native Monitor Protocol delivery belongs to a live frontend connection.
+//!
+//! A loaded thread is deliberately insufficient: app-server retains threads
+//! after the last frontend disconnects. This host never loads or resumes one.
+
+use std::collections::HashMap;
+use std::collections::HashSet;
+use std::io::Read;
+use std::path::Path;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::Weak;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+
+use crate::outgoing_message::OutgoingMessageSender;
+use crate::outgoing_message::ThreadScopedOutgoingMessageSender;
+use anyhow::bail;
+use codex_app_server_protocol::ServerNotification;
+use codex_app_server_protocol::WarningNotification;
+use codex_core::StartIfIdleSubmission;
+use codex_core::ThreadManager;
+use codex_core::TurnInput;
+use codex_core::TurnInputRequest;
+use codex_core::TurnStartOptions;
+use codex_monitor_extension::HostFuture;
+use codex_monitor_extension::MonitorHost;
+use codex_protocol::ThreadId;
+use codex_protocol::models::FunctionCallOutputPayload;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::AgentStatus;
+use codex_protocol::turn_input::TurnStartGuard;
+
+use crate::outgoing_message::ConnectionId;
+use crate::thread_state::ThreadStateManager;
+
+/// Operator configuration is snapshotted at server startup. Tool calls can only
+/// choose a registered name, never pair an arbitrary secret with a destination.
+pub(crate) fn configured_sources(
+    home: &Path,
+) -> HashMap<String, codex_monitor_extension::source::SourceConfig> {
+    let path = home.join("native-monitors/sources.json");
+    let file = match std::fs::File::open(path) {
+        Ok(file) => file,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return HashMap::new(),
+        Err(_) => {
+            tracing::warn!("native monitor source configuration is unreadable; no sources enabled");
+            return HashMap::new();
+        }
+    };
+    let mut bytes = Vec::new();
+    if file.take(1_048_577).read_to_end(&mut bytes).is_err() || bytes.len() > 1_048_576 {
+        tracing::warn!(
+            "native monitor source configuration exceeds limits or cannot be read; no sources enabled"
+        );
+        return HashMap::new();
+    }
+    serde_json::from_slice(&bytes).unwrap_or_else(|_| {
+        tracing::warn!("native monitor source configuration is invalid; no sources enabled");
+        HashMap::new()
+    })
+}
+
+#[derive(Default)]
+struct Revocations {
+    connections: HashSet<ConnectionId>,
+    unsubscribing: HashSet<(ThreadId, ConnectionId)>,
+    leases: HashMap<(ThreadId, ConnectionId), Arc<AtomicBool>>,
+}
+
+pub(crate) struct NativeMonitorHost {
+    threads: Weak<ThreadManager>,
+    subscriptions: ThreadStateManager,
+    revoked: Mutex<Revocations>,
+    outgoing: Option<Arc<OutgoingMessageSender>>,
+}
+
+impl NativeMonitorHost {
+    pub(crate) fn new(
+        threads: Weak<ThreadManager>,
+        subscriptions: ThreadStateManager,
+        outgoing: Option<Arc<OutgoingMessageSender>>,
+    ) -> Self {
+        Self {
+            threads,
+            subscriptions,
+            revoked: Mutex::default(),
+            outgoing,
+        }
+    }
+
+    // Revoke before any async RPC drain. Connection IDs are never reused within
+    // this server instance; no persisted owner is automatically reattached.
+    pub(crate) fn revoke_connection(&self, connection: ConnectionId) {
+        let mut revoked = self
+            .revoked
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        revoked.connections.insert(connection);
+        revoked.leases.retain(|(_, owner), lease| {
+            if *owner == connection {
+                lease.store(false, Ordering::Release);
+                false
+            } else {
+                true
+            }
+        });
+    }
+
+    pub(crate) fn begin_unsubscribe(&self, thread: ThreadId, connection: ConnectionId) {
+        let mut revoked = self
+            .revoked
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        revoked.unsubscribing.insert((thread, connection));
+        if let Some(lease) = revoked.leases.remove(&(thread, connection)) {
+            lease.store(false, Ordering::Release);
+        }
+    }
+
+    pub(crate) fn end_unsubscribe(&self, thread: ThreadId, connection: ConnectionId) {
+        self.revoked
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .unsubscribing
+            .remove(&(thread, connection));
+    }
+
+    fn is_revoked(&self, thread: ThreadId, connection: ConnectionId) -> bool {
+        let revoked = self
+            .revoked
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        revoked.connections.contains(&connection)
+            || revoked.unsubscribing.contains(&(thread, connection))
+    }
+
+    fn lease(&self, thread: ThreadId, owner: &str) -> Option<Arc<AtomicBool>> {
+        let connection = ConnectionId(owner.parse().ok()?);
+        let mut revoked = self
+            .revoked
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if revoked.connections.contains(&connection)
+            || revoked.unsubscribing.contains(&(thread, connection))
+        {
+            return None;
+        }
+        Some(Arc::clone(
+            revoked
+                .leases
+                .entry((thread, connection))
+                .or_insert_with(|| Arc::new(AtomicBool::new(true))),
+        ))
+    }
+
+    async fn attached(&self, thread: ThreadId, owner: &str) -> bool {
+        let Ok(id) = owner.parse::<u64>() else {
+            return false;
+        };
+        let connection = ConnectionId(id);
+        self.subscriptions
+            .subscribed_connection_ids(thread)
+            .await
+            .contains(&connection)
+            && !self.is_revoked(thread, connection)
+    }
+}
+
+impl MonitorHost for NativeMonitorHost {
+    fn owner(&self, thread: ThreadId) -> HostFuture<'_, String> {
+        Box::pin(async move {
+            let owners = self.subscriptions.subscribed_connection_ids(thread).await;
+            let [owner] = owners.as_slice() else {
+                bail!("a native monitor requires exactly one subscribed frontend connection");
+            };
+            if self.is_revoked(thread, *owner) {
+                bail!("the frontend connection is closing");
+            }
+            Ok(owner.0.to_string())
+        })
+    }
+
+    fn owner_attached<'a>(&'a self, thread: ThreadId, owner: &'a str) -> HostFuture<'a, bool> {
+        Box::pin(async move { Ok(self.attached(thread, owner).await) })
+    }
+
+    fn report_failure<'a>(
+        &'a self,
+        thread: ThreadId,
+        owner: &'a str,
+        message: &'a str,
+    ) -> HostFuture<'a, ()> {
+        Box::pin(async move {
+            if !self.attached(thread, owner).await {
+                return Ok(());
+            }
+            if let Some(outgoing) = &self.outgoing {
+                let connection = ConnectionId(owner.parse()?);
+                ThreadScopedOutgoingMessageSender::new(
+                    Arc::clone(outgoing),
+                    vec![connection],
+                    thread,
+                )
+                .send_server_notification(ServerNotification::Warning(WarningNotification {
+                    thread_id: Some(thread.to_string()),
+                    message: format!(
+                        "Native monitor stopped: {message}. Inspect monitor_status before rearming."
+                    ),
+                }))
+                .await;
+            }
+            Ok(())
+        })
+    }
+
+    fn deliver<'a>(
+        &'a self,
+        thread_id: ThreadId,
+        owner: &'a str,
+        metadata: String,
+        admission_open: Arc<AtomicBool>,
+    ) -> HostFuture<'a, bool> {
+        Box::pin(async move {
+            if !self.attached(thread_id, owner).await {
+                return Ok(false);
+            }
+            let Some(lease) = self.lease(thread_id, owner) else {
+                return Ok(false);
+            };
+            let Some(manager) = self.threads.upgrade() else {
+                return Ok(false);
+            };
+            let Ok(thread) = manager.get_thread(thread_id).await else {
+                return Ok(false);
+            };
+            if matches!(
+                thread.agent_status().await,
+                AgentStatus::Interrupted | AgentStatus::Shutdown | AgentStatus::NotFound
+            ) {
+                return Ok(false);
+            }
+            let item = ResponseItem::FunctionCallOutput {
+                id: None,
+                call_id: None,
+                name: Some("monitor_observation".to_string()),
+                namespace: None,
+                output: FunctionCallOutputPayload::from_text(metadata),
+                internal_chat_message_metadata_passthrough: None,
+            };
+            if !self.attached(thread_id, owner).await {
+                return Ok(false);
+            }
+            // Busy turns retain the pending observation. All automatic delivery
+            // goes through guarded idle admission, including the final owner check.
+            let start_options = thread
+                .thread_extension_data()
+                .get::<TurnStartOptions>()
+                .map(|options| options.as_ref().clone())
+                .unwrap_or_default();
+            if !self.attached(thread_id, owner).await {
+                return Ok(false);
+            }
+            // ResponseItem + StartIfIdle is automatic input: existing Plan mode
+            // and shutdown admission rules apply. No new thread is ever started.
+            Ok(matches!(
+                thread
+                    .start_turn_if_idle(
+                        TurnInputRequest::new(TurnInput::ResponseItem(item))
+                            .on_start(TurnStartOptions {
+                                turn_trigger: Some("monitor".to_string()),
+                                ..start_options
+                            })
+                            .with_start_guard(TurnStartGuard::new(move || lease
+                                .load(Ordering::Acquire)
+                                && admission_open.load(Ordering::Acquire)))
+                    )
+                    .await?,
+                StartIfIdleSubmission::Started { .. }
+            ))
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::thread_state::ConnectionCapabilities;
+
+    async fn subscribe(states: &ThreadStateManager, thread: ThreadId, id: u64) {
+        states
+            .connection_initialized(ConnectionId(id), ConnectionCapabilities::default())
+            .await;
+        assert!(
+            states
+                .try_add_connection_to_thread(thread, ConnectionId(id))
+                .await
+        );
+    }
+
+    #[tokio::test]
+    async fn binding_requires_one_owner_and_never_migrates_to_another_subscriber() {
+        let states = ThreadStateManager::new();
+        let host = NativeMonitorHost::new(Weak::new(), states.clone(), None);
+        let thread = ThreadId::new();
+        assert!(host.owner(thread).await.is_err());
+        subscribe(&states, thread, 1).await;
+        let owner = host.owner(thread).await.unwrap();
+        let lease = host.lease(thread, &owner).unwrap();
+        subscribe(&states, thread, 2).await;
+        assert!(host.owner(thread).await.is_err());
+        assert!(host.owner_attached(thread, &owner).await.unwrap());
+        host.revoke_connection(ConnectionId(1));
+        assert!(!lease.load(Ordering::Acquire));
+        assert!(!host.owner_attached(thread, &owner).await.unwrap());
+        assert!(host.owner_attached(thread, "2").await.unwrap());
+        // Transport state has not drained yet: revocation is already effective.
+        assert_eq!(states.subscribed_connection_ids(thread).await.len(), 2);
+    }
+
+    #[tokio::test]
+    async fn resubscription_cannot_revive_a_queued_admission_lease() {
+        let states = ThreadStateManager::new();
+        let host = NativeMonitorHost::new(Weak::new(), states.clone(), None);
+        let thread = ThreadId::new();
+        subscribe(&states, thread, 1).await;
+        let lease = host.lease(thread, "1").unwrap();
+        host.begin_unsubscribe(thread, ConnectionId(1));
+        assert!(host.owner(thread).await.is_err());
+        assert!(!lease.load(Ordering::Acquire));
+        host.end_unsubscribe(thread, ConnectionId(1));
+        let rearmed = host.lease(thread, "1").unwrap();
+        assert!(rearmed.load(Ordering::Acquire));
+        assert!(!lease.load(Ordering::Acquire));
+    }
+}
