+    let before = session.thread_settings_snapshot().await;
+    let previous_turn = session.state.lock().await.last_started_turn_id.clone();
+    let permitted = Arc::new(AtomicBool::new(true));
+    let predicate_flag = Arc::clone(&permitted);
+
+    // Force a real suspension after initial admission and before settings commit.
+    let persistence = thread_settings::acquire_persistence_lock(&session).await;
+    let submitted_session = Arc::clone(&session);
+    let submitted = tokio::spawn(async move {
+        handle(
+            &submitted_session,
+            TurnInputRequest::new(SubmittedTurnInput::ResponseItem(user_message(
+                "late observation must not survive host revocation",
+            )))
+            .with_thread_settings(ThreadSettingsOverrides {
+                effort: Some(Some(ReasoningEffort::High)),
+                ..Default::default()
+            })
+            .with_start_guard(TurnStartGuard::new(move || {
+                predicate_flag.load(Ordering::SeqCst)
+            })),
+            TurnInputMode::StartIfIdle,
+            "revoked-at-commit".to_string(),
+        )
+        .await
+    });
+    tokio::time::timeout(std::time::Duration::from_secs(5), async {
+        while session.active_turn.lock().await.is_none() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("request must pass its early guard and reserve an idle turn");
+
+    permitted.store(false, Ordering::SeqCst);
+    drop(persistence);
+    let result = submitted
+        .await
+        .expect("submission task must finish")
+        .expect("late revocation returns a typed non-admission");
+    assert_eq!(
+        result,
+        TurnInputSubmission::NotSubmitted {
+            reason: NotSubmittedReason::AdmissionRevoked,
+        }
+    );
+    assert_eq!(session.thread_settings_snapshot().await, before);
+    assert_eq!(
+        session.state.lock().await.last_started_turn_id,
+        previous_turn
+    );
+    assert!(session.active_turn.lock().await.is_none());
+    assert!(
+        session
+            .input_queue
+            .get_pending_input(&session.active_turn)
+            .await
+            .0
+            .is_empty()
+    );
+    assert!(
+        std::iter::from_fn(|| rx.try_recv().ok()).all(|event| { event.id != "revoked-at-commit" })
+    );
+
+    // A revoked request must not install a persistent admission condition.
+    let later = PreparedTurnInputSettings::prepare(
+        &session,
+        ThreadSettingsOverrides::default(),
+        TurnStartOptions::default(),
+    )
+    .await
+    .expect("prepare an unrelated later request")
+    .apply_started(
+        &session,
+        "later-user-input".to_string(),
+        TurnStartKind::User,
+    )
+    .await
+    .expect("unrelated request remains valid");
+    assert!(later.is_some());
+}
+
+#[test_case(TurnInputMode::StartOrSteer; "start or steer")]
+#[test_case(TurnInputMode::Steer { expected_turn_id: "any-turn".to_string() }; "steer only")]
+#[tokio::test]
+async fn start_guard_cannot_be_silently_ignored_by_steering(mode: TurnInputMode) {
+    let (session, _turn_context, _rx) = make_session_and_context_with_rx().await;
+    let result = handle(
+        &session,
+        TurnInputRequest::user_input(Vec::new()).with_start_guard(TurnStartGuard::new(|| false)),
+        mode,
+        "guarded-steering".to_string(),
+    )
+    .await;
+    let error = result.expect_err("guarded input requires an idle-start mode");
+    assert!(matches!(
+        error.details(),
+        CodexErrorDetails::InvalidRequest(_)
+    ));
+    assert!(session.active_turn.lock().await.is_none());
+}
