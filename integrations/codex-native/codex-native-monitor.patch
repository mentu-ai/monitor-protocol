+impl MonitorHost for TestHost {
+    fn owner(&self, _thread: ThreadId) -> HostFuture<'_, String> {
+        Box::pin(async {
+            if self.hold_owner.load(Ordering::Acquire) {
+                self.owner_entered.notify_one();
+                self.owner_release.notified().await;
+            }
+            Ok("connection:one".to_owned())
+        })
+    }
+    fn owner_attached<'a>(&'a self, _thread: ThreadId, owner: &'a str) -> HostFuture<'a, bool> {
+        Box::pin(
+            async move { Ok(owner == "connection:one" && self.attached.load(Ordering::Acquire)) },
+        )
+    }
+    fn deliver<'a>(
+        &'a self,
+        _thread: ThreadId,
+        owner: &'a str,
+        metadata: String,
+        admission_open: Arc<AtomicBool>,
+    ) -> HostFuture<'a, bool> {
+        Box::pin(async move {
+            self.admission_guards
+                .lock()
+                .unwrap()
+                .push(Arc::clone(&admission_open));
+            if self.hold_delivery.load(Ordering::Acquire) {
+                std::future::pending::<()>().await;
+            }
+            if !admission_open.load(Ordering::Acquire)
+                || owner != "connection:one"
+                || !self.attached.load(Ordering::Acquire)
+                || self.decline.load(Ordering::Acquire)
+            {
+                return Ok(false);
+            }
+            self.messages.lock().unwrap().push(metadata);
+            if self.fail_once.swap(false, Ordering::AcqRel) {
+                bail!("uncertain after acceptance");
+            }
+            Ok(true)
+        })
+    }
+    fn report_failure<'a>(
+        &'a self,
+        _thread: ThreadId,
+        _owner: &'a str,
+        message: &'a str,
+    ) -> HostFuture<'a, ()> {
+        Box::pin(async move {
+            self.failures.lock().unwrap().push(message.to_owned());
+            Ok(())
+        })
+    }
+}
+
+struct TestSource {
+    event: StdMutex<Option<Value>>,
+    empty_scan: StdMutex<Option<(u64, u64)>>,
+    acknowledgements: StdMutex<Vec<u64>>,
+    pulls: AtomicUsize,
+    lost_ack: AtomicBool,
+    hold_after_lost_ack: AtomicBool,
+    fail_pull: AtomicBool,
+    block_pull: AtomicBool,
+    block_ack: AtomicBool,
+}
+
+impl MonitorSource for TestSource {
+    fn base_url(&self) -> &str {
+        "https://example.invalid"
+    }
+    fn subscription(&self) -> &str {
+        "one"
+    }
+    fn pull(&self) -> SourceFuture<'_, PullOutcome> {
+        Box::pin(async {
+            self.pulls.fetch_add(1, Ordering::AcqRel);
+            if self.block_pull.load(Ordering::Acquire) {
+                std::future::pending::<()>().await;
+            }
+            if self.fail_pull.load(Ordering::Acquire) {
+                return Err(SourceError::invalid("unauthorized"));
+            }
+            if let Some(event) = self.event.lock().unwrap().clone() {
+                return Ok(PullOutcome::Event(SourceEvent { event, next: 8 }));
+            }
+            let (cursor, next) = self.empty_scan.lock().unwrap().unwrap_or((8, 8));
+            Ok(PullOutcome::Empty { cursor, next })
+        })
+    }
+    fn acknowledge(&self, next: u64) -> SourceFuture<'_, ()> {
+        Box::pin(async move {
+            if self.block_ack.load(Ordering::Acquire) {
+                std::future::pending::<()>().await;
+            }
+            self.acknowledgements.lock().unwrap().push(next);
+            self.event.lock().unwrap().take();
+            self.empty_scan.lock().unwrap().take();
+            if self.lost_ack.swap(false, Ordering::AcqRel) {
+                if self.hold_after_lost_ack.load(Ordering::Acquire) {
+                    self.block_ack.store(true, Ordering::Release);
+                }
+                return Err(SourceError::unavailable());
+            }
+            Ok(())
+        })
+    }
+}
