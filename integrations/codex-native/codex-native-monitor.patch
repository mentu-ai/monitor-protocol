@@ -0,0 +1,832 @@
+//! A read-only MP v0 subscription consumer. Credentials never enter journal state or errors.
+use std::sync::Mutex;
+use std::time::Duration;
+
+use reqwest::Client;
+use reqwest::Method;
+use reqwest::header::AUTHORIZATION;
+use reqwest::header::HeaderMap;
+use reqwest::header::HeaderValue;
+use serde::Deserialize;
+use serde::Serialize;
+use serde_json::Value;
+use serde_json::json;
+use url::Host;
+use url::Url;
+
+pub(crate) const MAX_SAFE_CURSOR: u64 = 9_007_199_254_740_991;
+const MAX_RESPONSE_BYTES: usize = 2_000_000;
+const REQUEST_TIMEOUT: Duration = Duration::from_secs(5);
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+pub struct SourceConfig {
+    pub base_url: String,
+    pub subscription: String,
+    pub token_env: String,
+}
+
+#[derive(Clone, Debug)]
+pub struct SourceEvent {
+    pub event: Value,
+    pub next: u64,
+}
+
+/// A validated pull page. Empty pages still carry the scanned cursor range:
+/// filtered-out observations must not pin a quiet subscription's committed cursor.
+#[derive(Clone, Debug)]
+pub enum PullOutcome {
+    Empty { cursor: u64, next: u64 },
+    Event(SourceEvent),
+}
+
+#[derive(Debug, thiserror::Error)]
+#[error("{message}")]
+pub struct SourceError {
+    retryable: bool,
+    message: &'static str,
+}
+
+impl SourceError {
+    pub(crate) fn invalid(message: &'static str) -> Self {
+        Self {
+            retryable: false,
+            message,
+        }
+    }
+
+    pub(crate) fn unavailable() -> Self {
+        Self {
+            retryable: true,
+            message: "MP transport unavailable; delivery and cursor retained",
+        }
+    }
+
+    pub fn is_retryable(&self) -> bool {
+        self.retryable
+    }
+}
+
+fn nonempty(value: &str) -> bool {
+    !value.is_empty() && !value.chars().any(|c| c.is_control() || c.is_whitespace())
+}
+
+fn canonical_base(base: &str) -> Result<String, SourceError> {
+    let parsed =
+        Url::parse(base).map_err(|_| SourceError::invalid("MP base must be an absolute URL"))?;
+    if !parsed.username().is_empty()
+        || parsed.password().is_some()
+        || parsed.query().is_some()
+        || parsed.fragment().is_some()
+    {
+        return Err(SourceError::invalid(
+            "MP base cannot contain credentials, query, or fragment",
+        ));
+    }
+    let loopback = match parsed.host() {
+        Some(Host::Domain(name)) => name == "localhost",
+        Some(Host::Ipv4(ip)) => ip.is_loopback(),
+        Some(Host::Ipv6(ip)) => ip.is_loopback(),
+        None => false,
+    };
+    if parsed.host().is_none()
+        || !(parsed.scheme() == "https" || (parsed.scheme() == "http" && loopback))
+    {
+        return Err(SourceError::invalid("MP requires HTTPS or loopback HTTP"));
+    }
+    if !matches!(parsed.path().trim_end_matches('/'), "" | "/mp/v0") {
+        return Err(SourceError::invalid("MP base path must be root or /mp/v0"));
+    }
+    Ok(parsed.origin().ascii_serialization())
+}
+
+pub(crate) fn safe_cursor(value: &Value) -> Option<u64> {
+    value.as_u64().filter(|n| *n <= MAX_SAFE_CURSOR)
+}
+
+pub(crate) fn sequence(event: &Value) -> Result<u64, SourceError> {
+    let text = event
+        .get("sequence")
+        .and_then(Value::as_str)
+        .ok_or_else(|| SourceError::invalid("MP observation requires a sequence string"))?;
+    if text.len() != 20 || !text.bytes().all(|c| c.is_ascii_digit()) {
+        return Err(SourceError::invalid(
+            "MP observation requires a 20 digit sequence",
+        ));
+    }
+    text.parse::<u64>()
+        .ok()
+        .filter(|n| *n < MAX_SAFE_CURSOR)
+        .ok_or_else(|| {
+            SourceError::invalid("MP observation sequence exceeds the safe cursor range")
+        })
+}
+
+fn in_vocabulary(event: &Value, field: &str, allowed: &[&str]) -> bool {
+    event
+        .get(field)
+        .and_then(Value::as_str)
+        .is_some_and(|value| allowed.contains(&value))
+}
+
+/// Validate required CloudEvents and MP provenance fields. Extension attributes remain open.
+pub(crate) fn validate_event(event: &Value) -> Result<(), SourceError> {
+    let invalid = || {
+        SourceError::invalid("MP observation does not conform to the required observation fields")
+    };
+    if !event.is_object() || event.get("specversion").and_then(Value::as_str) != Some("1.0") {
+        return Err(invalid());
+    }
+    for field in ["source", "id", "actor", "type", "time"] {
+        if !event
+            .get(field)
+            .and_then(Value::as_str)
+            .is_some_and(nonempty)
+        {
+            return Err(invalid());
+        }
+    }
+    sequence(event)?;
+    let kind = event["type"].as_str().ok_or_else(invalid)?;
+    let parts = kind.split('.').collect::<Vec<_>>();
+    if parts.len() < 2
+        || parts.iter().enumerate().any(|(index, part)| {
+            part.is_empty()
+                || !part.bytes().all(|b| {
+                    b.is_ascii_lowercase()
+                        || b.is_ascii_digit()
+                        || (index > 0 && matches!(b, b'_' | b'-'))
+                })
+        })
+        || chrono::DateTime::parse_from_rfc3339(event["time"].as_str().ok_or_else(invalid)?)
+            .is_err()
+    {
+        return Err(invalid());
+    }
+    let tiers = ["src", "measured", "derived", "unverified", "falsified"];
+    let origins = ["human", "agent", "webhook", "probe", "system"];
+    let verification = [
+        "human_verified",
+        "machine_verified",
+        "certified",
+        "reported",
+        "unverified",
+    ];
+    if !in_vocabulary(event, "tier", &tiers)
+        || !in_vocabulary(event, "origin", &origins)
+        || !in_vocabulary(event, "verified", &verification)
+        || !in_vocabulary(
+            event,
+            "horizon",
+            &["event", "minute", "hour", "day", "week", "month"],
+        )
+        || event.get("redelivered").is_some_and(|v| !v.is_boolean())
+    {
+        return Err(invalid());
+    }
+    match (event.get("data"), event.get("data_base64")) {
+        (Some(data), None) if data.is_object() => {
+            let provenance = data
+                .get("provenance")
+                .filter(|v| v.is_object())
+                .ok_or_else(invalid)?;
+            if !in_vocabulary(provenance, "tier", &tiers)
+                || !in_vocabulary(provenance, "origin", &origins)
+                || !in_vocabulary(provenance, "verification", &verification)
+                || !provenance
+                    .get("actor")
+                    .and_then(Value::as_str)
+                    .is_some_and(nonempty)
+            {
+                return Err(invalid());
+            }
+        }
+        (None, Some(data)) if data.is_string() => {}
+        _ => return Err(invalid()),
+    }
+    Ok(())
+}
+
+/// Only the subscription bearer is loaded. This client never creates subscriptions, seeks,
+/// rotates credentials, claims work, or interprets observation payloads as instructions.
+pub struct MpSource {
+    base_url: String,
+    subscription: String,
+    client: Client,
+    cursor: Mutex<Option<u64>>,
+}
+
+impl MpSource {
+    pub fn new(config: &SourceConfig) -> Result<Self, SourceError> {
+        let mut chars = config.token_env.bytes();
+        if !chars
+            .next()
+            .is_some_and(|b| b.is_ascii_alphabetic() || b == b'_')
+            || !chars.all(|b| b.is_ascii_alphanumeric() || b == b'_')
+        {
+            return Err(SourceError::invalid(
+                "token_env must name an environment variable",
+            ));
+        }
+        let token = std::env::var(&config.token_env).map_err(|_| {
+            SourceError::invalid(
+                "the configured subscription token environment variable is missing",
+            )
+        })?;
+        Self::with_token(config, &token)
+    }
+
+    fn with_token(config: &SourceConfig, token: &str) -> Result<Self, SourceError> {
+        let base_url = canonical_base(&config.base_url)?;
+        if !nonempty(&config.subscription)
+            || matches!(config.subscription.as_str(), "." | "..")
+            || config.subscription.len() > 4096
+            || token.is_empty()
+            || token.len() > 65536
+            || token.chars().any(|c| c.is_control() || c.is_whitespace())
+        {
+            return Err(SourceError::invalid(
+                "an existing subscription and valid bearer token are required",
+            ));
+        }
+        let mut authorization = HeaderValue::from_str(&format!("Bearer {token}"))
+            .map_err(|_| SourceError::invalid("the configured bearer token is invalid"))?;
+        authorization.set_sensitive(true);
+        let mut headers = HeaderMap::new();
+        headers.insert(AUTHORIZATION, authorization);
+        let client = Client::builder()
+            .default_headers(headers)
+            .redirect(reqwest::redirect::Policy::none())
+            .timeout(REQUEST_TIMEOUT)
+            .connect_timeout(REQUEST_TIMEOUT)
+            .build()
+            .map_err(|_| SourceError::invalid("cannot initialize MP HTTP transport"))?;
+        Ok(Self {
+            base_url,
+            subscription: config.subscription.clone(),
+            client,
+            cursor: Mutex::new(None),
+        })
+    }
+
+    pub fn base_url(&self) -> &str {
+        &self.base_url
+    }
+    pub fn subscription(&self) -> &str {
+        &self.subscription
+    }
+
+    async fn request(&self, action: &str, body: Option<Value>) -> Result<Value, SourceError> {
+        let mut url = Url::parse(&self.base_url)
+            .map_err(|_| SourceError::invalid("invalid saved MP base"))?;
+        url.path_segments_mut()
+            .map_err(|_| SourceError::invalid("invalid saved MP base"))?
+            .extend(["mp", "v0", "subscriptions", &self.subscription, action]);
+        if action == "pull" {
+            url.set_query(Some("wait=0&limit=1"));
+        }
+        let mut request = self.client.request(
+            if body.is_some() {
+                Method::POST
+            } else {
+                Method::GET
+            },
+            url,
+        );
+        if let Some(body) = body {
+            request = request.json(&body);
+        }
+        let mut response = request
+            .send()
+            .await
+            .map_err(|_| SourceError::unavailable())?;
+        let status = response.status();
+        if status.is_redirection() {
+            return Err(SourceError::invalid(
+                "MP redirects are refused; cursor retained",
+            ));
+        }
+        if !status.is_success() {
+            return if status.as_u16() == 408 || status.as_u16() == 429 || status.is_server_error() {
+                Err(SourceError::unavailable())
+            } else {
+                Err(SourceError::invalid(
+                    "MP refused the subscription request; no cursor reset performed",
+                ))
+            };
+        }
+        if response
+            .content_length()
+            .is_some_and(|n| n > MAX_RESPONSE_BYTES as u64)
+        {
+            return Err(SourceError::invalid("MP response exceeds the size limit"));
+        }
+        let mut bytes = Vec::new();
+        while let Some(chunk) = response
+            .chunk()
+            .await
+            .map_err(|_| SourceError::unavailable())?
+        {
+            if bytes.len().saturating_add(chunk.len()) > MAX_RESPONSE_BYTES {
+                return Err(SourceError::invalid("MP response exceeds the size limit"));
+            }
+            bytes.extend_from_slice(&chunk);
+        }
+        let value: Value = serde_json::from_slice(&bytes)
+            .map_err(|_| SourceError::invalid("MP response must contain valid UTF-8 JSON"))?;
+        if !value.is_object()
+            || value.get("subscription").and_then(Value::as_str) != Some(&self.subscription)
+        {
+            return Err(SourceError::invalid(
+                "MP response does not name this subscription",
+            ));
+        }
+        Ok(value)
+    }
+
+    fn parse_page(&self, page: Value) -> Result<PullOutcome, SourceError> {
+        let cursor = |name: &str| {
+            page.get(name).and_then(safe_cursor).ok_or_else(|| {
+                SourceError::invalid("MP response requires safe non-negative cursors")
+            })
+        };
+        let committed = cursor("cursor")?;
+        let next = cursor("next")?;
+        let head = cursor("head")?;
+        let floor = cursor("retention_floor")?;
+        if floor > committed.max(1) {
+            return Err(SourceError::invalid(
+                "MP cursor is below retention floor; no cursor reset performed",
+            ));
+        }
+        if committed > head.saturating_add(1) || next < committed || next > head.saturating_add(1) {
+            return Err(SourceError::invalid("MP response cursors are inconsistent"));
+        }
+        let observations = page
+            .get("observations")
+            .and_then(Value::as_array)
+            .filter(|rows| rows.len() <= 1)
+            .ok_or_else(|| SourceError::invalid("MP must return at most one observation"))?;
+        let result = if let Some(raw) = observations.first() {
+            validate_event(raw)?;
+            let seq = sequence(raw)?;
+            if next != seq + 1 || seq < committed || seq < floor || seq > head {
+                return Err(SourceError::invalid(
+                    "MP next cursor does not match the delivered observation",
+                ));
+            }
+            let mut event = raw.clone();
+            if let Some(object) = event.as_object_mut() {
+                object.remove("redelivered");
+            }
+            PullOutcome::Event(SourceEvent { event, next })
+        } else {
+            if next != head + 1 {
+                return Err(SourceError::invalid(
+                    "MP empty response has an inconsistent next cursor",
+                ));
+            }
+            PullOutcome::Empty {
+                cursor: committed,
+                next,
+            }
+        };
+        let mut expected = self
+            .cursor
+            .lock()
+            .map_err(|_| SourceError::invalid("MP cursor state unavailable"))?;
+        if expected.is_some_and(|previous| previous != committed) {
+            return Err(SourceError::invalid(
+                "MP subscription cursor changed outside this consumer; reconcile before continuing",
+            ));
+        }
+        *expected = Some(committed);
+        Ok(result)
+    }
+
+    pub async fn pull(&self) -> Result<PullOutcome, SourceError> {
+        self.parse_page(self.request("pull", None).await?)
+    }
+
+    /// Call only after the matching handling receipt or validated empty-scan receipt has
+    /// been durably recorded in the journal. An empty scan never handles an observation.
+    pub async fn acknowledge(&self, next: u64) -> Result<(), SourceError> {
+        if next > MAX_SAFE_CURSOR {
+            return Err(SourceError::invalid(
+                "MP acknowledgement requires a safe cursor",
+            ));
+        }
+        let result = self.request("ack", Some(json!({ "cursor": next }))).await?;
+        if result.get("cursor").and_then(safe_cursor) != Some(next) {
+            return Err(SourceError::invalid(
+                "MP acknowledgement did not commit the requested cursor",
+            ));
+        }
+        *self
+            .cursor
+            .lock()
+            .map_err(|_| SourceError::invalid("MP cursor state unavailable"))? = Some(next);
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+#[allow(clippy::unwrap_used)]
+mod tests {
+    use super::*;
+    use tokio::io::AsyncReadExt;
+    use tokio::io::AsyncWriteExt;
+    use tokio::net::TcpListener;
+    use tokio::net::TcpStream;
+
+    fn event() -> Value {
+        json!({"specversion":"1.0","source":"monitor:test","id":"event-7",
+            "sequence":"00000000000000000007","type":"com.example.changed","time":"2026-10-11T00:00:00Z",
+            "tier":"measured","origin":"probe","verified":"machine_verified","horizon":"event","actor":"system:test",
+            "data":{"provenance":{"tier":"measured","origin":"probe","verification":"machine_verified","actor":"system:test"}}})
+    }
+
+    fn page() -> Value {
+        json!({"subscription":"one","cursor":0,"next":8,"head":7,"retention_floor":1,"observations":[event()]})
+    }
+
+    fn source(base: &str) -> MpSource {
+        MpSource::with_token(
+            &SourceConfig {
+                base_url: base.to_string(),
+                subscription: "one".to_string(),
+                token_env: "TEST_TOKEN".to_string(),
+            },
+            "test-token",
+        )
+        .unwrap()
+    }
+
+    async fn read_request(stream: &mut TcpStream) -> String {
+        let mut request = Vec::new();
+        loop {
+            let mut chunk = [0; 1024];
+            let count = stream.read(&mut chunk).await.unwrap();
+            if count == 0 {
+                break;
+            }
+            request.extend_from_slice(&chunk[..count]);
+            assert!(request.len() < 16 * 1024, "bounded fixture request");
+            if let Some(end) = request.windows(4).position(|bytes| bytes == b"\r\n\r\n") {
+                let header = String::from_utf8_lossy(&request[..end]).to_ascii_lowercase();
+                let length = header
+                    .lines()
+                    .find_map(|line| line.strip_prefix("content-length: "))
+                    .and_then(|n| n.parse::<usize>().ok())
+                    .unwrap_or(0);
+                if request.len() >= end + 4 + length {
+                    break;
+                }
+            }
+        }
+        String::from_utf8(request).unwrap()
+    }
+
+    async fn server(
+        status: &str,
+        body: Vec<u8>,
+        headers: &str,
+    ) -> (String, tokio::task::JoinHandle<String>) {
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let base = format!("http://{}", listener.local_addr().unwrap());
+        let response = format!(
+            "HTTP/1.1 {status}\r\nContent-Length: {}\r\nConnection: close\r\n{headers}\r\n",
+            body.len()
+        );
+        let handle = tokio::spawn(async move {
+            let (mut stream, _) = listener.accept().await.unwrap();
+            let request = read_request(&mut stream).await;
+            let _ = stream.write_all(response.as_bytes()).await;
+            let _ = stream.write_all(&body).await;
+            request
+        });
+        (base, handle)
+    }
+
+    #[test]
+    fn restricts_bases_and_does_not_expose_environment_credentials() {
+        assert_eq!(
+            canonical_base("https://example.com/mp/v0/").unwrap(),
+            "https://example.com"
+        );
+        assert!(canonical_base("http://[::1]:8130").is_ok());
+        for base in [
+            "http://example.com",
+            "https://user:secret@example.com",
+            "https://example.com?token=secret",
+            "https://example.com/#fragment",
+            "https://example.com/other",
+            "file:///tmp/mp",
+        ] {
+            assert!(canonical_base(base).is_err());
+        }
+        let config = SourceConfig {
+            base_url: "https://example.com".to_string(),
+            subscription: "one".to_string(),
+            token_env: "INVALID-NAME".to_string(),
+        };
+        assert!(!MpSource::new(&config).err().unwrap().is_retryable());
+        let error = MpSource::with_token(&config, "secret\r\ninvalid")
+            .err()
+            .unwrap();
+        assert!(!error.to_string().contains("secret"));
+    }
+
+    #[test]
+    fn rejects_malformed_events_retention_gaps_and_unexpected_cursor_changes() {
