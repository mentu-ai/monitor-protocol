+    f.source.block_ack.store(false, Ordering::Release);
+    f.source.block_pull.store(true, Ordering::Release);
+    let resumed = Arc::new(MonitorScope::new(f.scope.thread));
+    let mut resumed_service = MonitorService::new(
+        f.host.clone(),
+        f.service.journal_root.clone(),
+        HashMap::new(),
+    );
+    resumed_service.poll = Duration::from_secs(60);
+    let fresh = resumed_service
+        .start_source(resumed.clone(), f.source.clone())
+        .await?
+        .monitor_id;
+    wait(|| f.source.acknowledgements.lock().unwrap().len() >= 2).await?;
+    assert_eq!(*f.source.acknowledgements.lock().unwrap(), vec![8, 8]);
+    assert_eq!(
+        f.source.pulls.load(Ordering::Acquire),
+        pulls,
+        "scan recovery must acknowledge the receipt before any pull"
+    );
+    assert!(f.host.messages.lock().unwrap().is_empty());
+    resumed_service.stop(&resumed, &fresh).await?;
+    Ok(())
+}
+
+#[tokio::test]
+async fn empty_scan_cannot_skip_an_observation_that_is_waiting_for_handling() -> Result<()> {
+    let f = Fixture::new()?;
+    let id = f.start().await?;
+    let item = f.delivered(&id).await?;
+    f.source.event.lock().unwrap().take();
+    *f.source.empty_scan.lock().unwrap() = Some((7, 10));
+    let run = f.service.run(&f.scope, &id)?;
+    wait(|| run.state.lock().unwrap().phase == Phase::Failed).await?;
+    assert_eq!(
+        run.state.lock().unwrap().delivery.as_deref(),
+        Some(item.id.as_str())
+    );
+    assert!(f.source.acknowledgements.lock().unwrap().is_empty());
+    assert_eq!(f.host.messages.lock().unwrap().len(), 1);
+    f.service.stop(&f.scope, &id).await?;
+    Ok(())
+}
+
+#[tokio::test]
+async fn quiescent_source_with_no_cursor_advance_does_not_ack_or_wake() -> Result<()> {
+    let f = Fixture::new()?;
+    f.source.event.lock().unwrap().take();
+    let id = f.start().await?;
+    wait(|| f.source.pulls.load(Ordering::Acquire) >= 3).await?;
+    assert!(f.source.acknowledgements.lock().unwrap().is_empty());
+    assert!(f.host.messages.lock().unwrap().is_empty());
+    let run = f.service.run(&f.scope, &id)?;
+    assert!(
+        run.with_journal(|journal| journal.pending_scan())
+            .await?
+            .is_none()
+    );
+    f.service.stop(&f.scope, &id).await?;
+    Ok(())
+}
