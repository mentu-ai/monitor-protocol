+//! Monitor Protocol subscriptions owned by an attended native session, not a shell process.
+
+use std::collections::HashMap;
+use std::path::PathBuf;
+use std::sync::Arc;
+
+use codex_extension_api::ExtensionData;
+use codex_extension_api::ExtensionFuture;
+use codex_extension_api::ExtensionRegistryBuilder;
+use codex_extension_api::ThreadIdleCause;
+use codex_extension_api::ThreadIdleInput;
+use codex_extension_api::ThreadLifecycleContributor;
+use codex_extension_api::ThreadReadyInput;
+use codex_extension_api::ThreadStopInput;
+use codex_extension_api::ToolCall;
+use codex_extension_api::ToolContributor;
+use codex_extension_api::ToolExecutor;
+use codex_protocol::ThreadId;
+
+pub mod journal;
+mod runtime;
+pub mod source;
+mod tools;
+
+pub use runtime::HostFuture;
+pub use runtime::MonitorHost;
+pub use runtime::MonitorService;
+pub use runtime::MonitorStatus;
+
+struct MonitorExtension {
+    service: Arc<MonitorService>,
+}
+
+impl<C: Send + Sync + 'static> ThreadLifecycleContributor<C> for MonitorExtension {
+    fn on_thread_ready<'a>(&'a self, input: ThreadReadyInput<'a, C>) -> ExtensionFuture<'a, ()> {
+        Box::pin(async move {
+            if let Ok(thread) = ThreadId::from_string(input.thread_store.level_id()) {
+                // A resumed runtime receives a fresh identity and no subscriptions. A previous
+                // human connection's monitor can never silently attach to this runtime.
+                input
+                    .thread_store
+                    .insert(runtime::MonitorScope::new(thread));
+            }
+        })
+    }
+
+    fn on_thread_idle<'a>(&'a self, input: ThreadIdleInput<'a>) -> ExtensionFuture<'a, ()> {
+        Box::pin(async move {
+            if input.cause == ThreadIdleCause::Interrupted {
+                if let Some(scope) = input.thread_store.get::<runtime::MonitorScope>() {
+                    self.service.interrupt_scope(&scope).await;
+                }
+            }
+        })
+    }
+
+    fn on_thread_stop<'a>(&'a self, input: ThreadStopInput<'a>) -> ExtensionFuture<'a, ()> {
+        Box::pin(async move {
+            if let Some(scope) = input.thread_store.get::<runtime::MonitorScope>() {
+                self.service.stop_scope(&scope).await;
+            }
+        })
+    }
+}
+
+impl ToolContributor for MonitorExtension {
+    fn tools(
+        &self,
+        _session_store: &ExtensionData,
+        thread_store: &ExtensionData,
+    ) -> Vec<Arc<dyn for<'call> ToolExecutor<ToolCall<'call>>>> {
+        if !self.service.has_sources() {
+            return Vec::new();
+        }
+        let Some(scope) = thread_store.get::<runtime::MonitorScope>() else {
+            return Vec::new();
+        };
+        tools::tools(Arc::clone(&self.service), scope)
+    }
+}
+
+/// Install compiled native tools and thread teardown. The host must also call `stop_owner`
+/// on connection loss and `stop_thread_owner` on unsubscribe; loaded does not imply attended.
+pub fn install<C: Send + Sync + 'static>(
+    registry: &mut ExtensionRegistryBuilder<C>,
+    host: Arc<dyn MonitorHost>,
+    journal_root: PathBuf,
+    sources: HashMap<String, source::SourceConfig>,
+) -> Arc<MonitorService> {
+    let service = Arc::new(MonitorService::new(host, journal_root, sources));
+    let extension = Arc::new(MonitorExtension {
+        service: Arc::clone(&service),
+    });
+    registry.thread_lifecycle_contributor(extension.clone());
+    registry.tool_contributor(extension);
+    service
+}
