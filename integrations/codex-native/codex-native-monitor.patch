+//! Private durable delivery state. Pull, enqueue, handling, and source ack are separate facts.
+use std::fs;
+use std::fs::File;
+use std::fs::OpenOptions;
+use std::io::Read;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+
+use anyhow::Context;
+use anyhow::Result;
+use anyhow::bail;
+use fs2::FileExt;
+use serde::Deserialize;
+use serde::Serialize;
+use serde::de::DeserializeOwned;
+use serde_json::Value;
+use serde_json::json;
+use sha2::Digest;
+use sha2::Sha256;
+use uuid::Uuid;
+
+use crate::source::MAX_SAFE_CURSOR;
+use crate::source::sequence;
+use crate::source::validate_event;
+
+const MAX_JOURNAL_FILE_BYTES: u64 = 2_100_000;
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+pub struct Binding {
+    pub thread_id: String,
+    pub owner: String,
+    pub session_nonce: String,
+    pub base_url: String,
+    pub subscription: String,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+pub struct Delivery {
+    pub id: String,
+    pub fingerprint: String,
+    pub event: Value,
+    pub next: u64,
+    pub created: String,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+pub struct HandlingReceipt {
+    pub delivery: String,
+    pub fingerprint: String,
+    pub evidence: String,
+    pub handled: String,
+}
+
+/// Durable evidence that a validated source page contained no matching observations.
+/// This authorizes only committing its scanned cursor range, never handling an event.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+pub struct ScanReceipt {
+    pub id: String,
+    pub cursor: u64,
+    pub next: u64,
+    pub scanned: String,
+    pub fingerprint: String,
+}
+
+#[derive(Deserialize, Serialize)]
+struct Acknowledgement {
+    fingerprint: String,
+    acknowledged: String,
+}
+
+#[derive(Deserialize, Serialize)]
+struct QueueMark {
+    fingerprint: String,
+    queued: String,
+}
+
+fn now() -> String {
+    chrono::Utc::now().to_rfc3339()
+}
+
+/// Stable JSON object-key order, independent of serde_json's preserve_order feature.
+fn canonical(value: &Value) -> Value {
+    match value {
+        Value::Object(object) => {
+            let sorted = object.iter().collect::<std::collections::BTreeMap<_, _>>();
+            Value::Object(
+                sorted
+                    .into_iter()
+                    .map(|(key, value)| (key.clone(), canonical(value)))
+                    .collect(),
+            )
+        }
+        Value::Array(values) => Value::Array(values.iter().map(canonical).collect()),
+        _ => value.clone(),
+    }
+}
+
+pub fn fingerprint(value: &Value) -> String {
+    format!(
+        "sha256:{:x}",
+        Sha256::digest(canonical(value).to_string().as_bytes())
+    )
+}
+
+fn private_metadata(path: &Path, directory: bool) -> Result<fs::Metadata> {
+    let metadata = fs::symlink_metadata(path).context("cannot inspect private monitor state")?;
+    if metadata.file_type().is_symlink()
+        || (directory && !metadata.is_dir())
+        || (!directory && !metadata.is_file())
+    {
+        bail!("monitor state must use regular files and directories, not symlinks");
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        if metadata.mode() & 0o077 != 0 || metadata.uid() != rustix::process::geteuid().as_raw() {
+            bail!("monitor state must be private and owned by the current operating-system user");
+        }
+    }
+    #[cfg(not(unix))]
+    bail!("native monitor private journal currently supports Unix platforms only");
+    Ok(metadata)
+}
+
+/// One owner holds the OS advisory lock for this journal's entire activation. The lock file
+/// is never unlinked: unlinking it could permit two consumers to lock different inodes.
+pub struct Journal {
+    path: PathBuf,
+    binding: Binding,
+    _lock: File,
+}
+
+impl Journal {
+    pub fn open(path: &Path, binding: Binding) -> Result<Self> {
+        Self::open_inner(path, binding, false)
+    }
+
+    /// Explicit rearming by an authenticated attending client. The caller must first verify
+    /// its current live ownership. A different thread or source cannot adopt this journal.
+    pub fn rearm(path: &Path, binding: Binding) -> Result<Self> {
+        Self::open_inner(path, binding, true)
+    }
+
+    fn open_inner(path: &Path, binding: Binding, rearm: bool) -> Result<Self> {
+        if [
+            &binding.thread_id,
+            &binding.owner,
+            &binding.session_nonce,
+            &binding.base_url,
+            &binding.subscription,
+        ]
+        .iter()
+        .any(|field| field.is_empty())
+        {
+            bail!("monitor journal binding is incomplete");
+        }
+        let mut builder = fs::DirBuilder::new();
+        builder.recursive(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::DirBuilderExt;
+            builder.mode(0o700);
+        }
+        builder
+            .create(path)
+            .context("cannot create private monitor directory")?;
+        private_metadata(path, true)?;
+        let path = fs::canonicalize(path).context("cannot resolve monitor journal")?;
+        let lock_path = path.join("worker.lock");
+        match fs::symlink_metadata(&lock_path) {
+            Ok(_) => {
+                private_metadata(&lock_path, false)?;
+            }
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+            Err(error) => return Err(error).context("cannot inspect monitor worker lock"),
+        }
+        let mut options = OpenOptions::new();
+        options.read(true).write(true).create(true).truncate(false);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            options.mode(0o600);
+        }
+        let mut lock = options
+            .open(&lock_path)
+            .context("cannot open monitor worker lock")?;
+        private_metadata(&lock_path, false)?;
+        FileExt::try_lock_exclusive(&lock).context("another native monitor owns this journal")?;
+        lock.set_len(0)
+            .context("cannot record monitor worker lock")?;
+        lock.write_all(
+            serde_json::to_string(&json!({ "pid": std::process::id(), "started": now() }))?
+                .as_bytes(),
+        )?;
+        lock.sync_all()?;
+        let journal = Self {
+            path,
+            binding,
+            _lock: lock,
+        };
+        let previous = journal.read::<Binding>("binding.json")?;
+        if let Some(saved) = &previous {
+            if saved.thread_id != journal.binding.thread_id
+                || saved.base_url != journal.binding.base_url
+                || saved.subscription != journal.binding.subscription
+                || (!rearm && saved != &journal.binding)
+            {
+                bail!("journal belongs to a different owner, thread, session, or source");
+            }
+        }
+        // Opening an existing journal must validate pending state before any network action.
+        let pending = journal.pending()?;
+        journal.pending_scan()?;
+        if previous.as_ref() != Some(&journal.binding) {
+            journal.put("binding.json", &journal.binding)?;
+        }
+        if rearm {
+            if let Some(item) = pending {
+                if journal.queued(&item.id)? && journal.receipt(&item.id)?.is_none() {
+                    // Prior enqueue metadata may name a stopped activation. Reissue this
+                    // delivery identity with fresh metadata, never an acknowledgement.
+                    fs::remove_file(journal.path.join(format!("queued-{}.json", item.id)))?;
+                    File::open(&journal.path)?.sync_all()?;
+                }
+            }
+        }
+        Ok(journal)
+    }
+
+    pub fn header(&self) -> &Binding {
+        &self.binding
+    }
+    pub fn path(&self) -> &Path {
+        &self.path
+    }
+
+    fn read<T: DeserializeOwned>(&self, name: &str) -> Result<Option<T>> {
+        let path = self.path.join(name);
+        match fs::symlink_metadata(&path) {
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+            Err(error) => return Err(error).context("cannot inspect monitor journal file"),
+            Ok(_) => {}
+        }
+        let metadata = private_metadata(&path, false)?;
+        if metadata.len() > MAX_JOURNAL_FILE_BYTES {
+            bail!("monitor journal file exceeds size limit");
+        }
+        let mut bytes = Vec::new();
+        File::open(&path)?
+            .take(MAX_JOURNAL_FILE_BYTES + 1)
+            .read_to_end(&mut bytes)?;
+        if bytes.len() as u64 > MAX_JOURNAL_FILE_BYTES {
+            bail!("monitor journal file exceeds size limit");
+        }
+        serde_json::from_slice(&bytes)
+            .map(Some)
+            .context("invalid monitor journal JSON")
+    }
+
+    fn put<T: Serialize>(&self, name: &str, value: &T) -> Result<()> {
+        let bytes = serde_json::to_vec(value)?;
+        if bytes.len() as u64 > MAX_JOURNAL_FILE_BYTES {
+            bail!("monitor journal file exceeds size limit");
+        }
+        let temporary = self.path.join(format!(".tmp-{}", Uuid::new_v4()));
+        let result = (|| -> Result<()> {
+            let mut options = OpenOptions::new();
+            options.create_new(true).write(true);
+            #[cfg(unix)]
+            {
+                use std::os::unix::fs::OpenOptionsExt;
+                options.mode(0o600);
+            }
+            let mut file = options.open(&temporary)?;
+            file.write_all(&bytes)?;
+            file.sync_all()?;
+            fs::rename(&temporary, self.path.join(name))?;
+            File::open(&self.path)?.sync_all()?;
+            Ok(())
+        })();
+        if result.is_err() {
+            let _ = fs::remove_file(&temporary);
+        }
+        result.context("cannot durably record monitor journal state")
+    }
+
+    fn check_id(id: &str) -> Result<()> {
+        if id.len() != 64
+            || !id
+                .bytes()
+                .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+        {
+            bail!("invalid monitor delivery id");
+        }
+        Ok(())
+    }
+
+    fn event_id(&self, event: &Value) -> String {
+        fingerprint(&json!([
+            self.binding.thread_id,
+            self.binding.base_url,
+            self.binding.subscription,
+            event["source"],
+            event["id"]
+        ]))[7..]
+            .to_string()
+    }
+
+    pub fn get(&self, id: &str) -> Result<Delivery> {
+        Self::check_id(id)?;
+        let item = self
+            .read::<Delivery>(&format!("delivery-{id}.json"))?
+            .context("monitor delivery is missing")?;
+        validate_event(&item.event)?;
+        if item.id != id
+            || self.event_id(&item.event) != id
+            || fingerprint(&item.event) != item.fingerprint
+            || sequence(&item.event)? + 1 != item.next
+            || chrono::DateTime::parse_from_rfc3339(&item.created).is_err()
+        {
+            bail!("monitor delivery is inconsistent or has changed");
+        }
+        Ok(item)
+    }
+
+    pub fn pending(&self) -> Result<Option<Delivery>> {
+        let mut pending = None;
+        for entry in fs::read_dir(&self.path)? {
+            let name = entry?.file_name();
+            let name = name.to_string_lossy();
+            if let Some(id) = name
+                .strip_prefix("delivery-")
+                .and_then(|name| name.strip_suffix(".json"))
+            {
+                Self::check_id(id)?;
+                let item = self.get(id)?;
+                self.receipt(id)?;
+                if !self.acked(id)? {
+                    if pending.is_some() {
+                        bail!("multiple pending monitor deliveries; refusing to skip one");
+                    }
+                    pending = Some(item);
+                }
+            }
+        }
+        Ok(pending)
+    }
+
+    pub fn add(&mut self, mut event: Value, next: u64) -> Result<Delivery> {
+        if self.pending_scan()?.is_some() {
+            bail!("cannot add an event while an empty scan acknowledgement is pending");
+        }
+        validate_event(&event)?;
+        if let Some(object) = event.as_object_mut() {
+            object.remove("redelivered");
+        }
+        if next != sequence(&event)? + 1 {
+            bail!("monitor delivery has inconsistent next cursor");
+        }
+        let id = self.event_id(&event);
+        if let Some(prior) = self.read::<Delivery>(&format!("delivery-{id}.json"))? {
+            let item = self.get(&prior.id)?;
+            if item.id != id || item.fingerprint != fingerprint(&event) || item.next != next {
+                bail!("monitor event identity was reused with changed content");
+            }
+            if self.acked(&id)? {
+                bail!("source redelivered an acknowledged event; reconcile its cursor");
+            }
+            return Ok(item);
+        }
+        if self.pending()?.is_some() {
+            bail!("cannot add another event while a delivery is pending");
+        }
+        let item = Delivery {
+            id,
+            fingerprint: fingerprint(&event),
+            event,
+            next,
+            created: now(),
+        };
+        self.put(&format!("delivery-{}.json", item.id), &item)?;
+        self.get(&item.id)
+    }
+
+    pub fn queued(&self, id: &str) -> Result<bool> {
+        let item = self.get(id)?;
+        let mark = self.read::<QueueMark>(&format!("queued-{id}.json"))?;
+        if let Some(mark) = &mark {
+            if mark.fingerprint != item.fingerprint
+                || chrono::DateTime::parse_from_rfc3339(&mark.queued).is_err()
+            {
+                bail!("monitor queue marker does not match this delivery");
+            }
+        }
+        Ok(mark.is_some())
+    }
+
+    pub fn mark_queued(&mut self, id: &str) -> Result<()> {
+        let item = self.get(id)?;
+        self.put(
+            &format!("queued-{id}.json"),
+            &QueueMark {
+                fingerprint: item.fingerprint,
+                queued: now(),
+            },
+        )
+    }
+
+    pub fn receipt(&self, id: &str) -> Result<Option<HandlingReceipt>> {
+        let item = self.get(id)?;
+        let receipt = self.read::<HandlingReceipt>(&format!("receipt-{id}.json"))?;
+        if let Some(receipt) = &receipt {
+            if receipt.delivery != id
+                || receipt.fingerprint != item.fingerprint
+                || receipt.evidence.trim().is_empty()
+                || receipt.evidence.len() > 8000
+                || chrono::DateTime::parse_from_rfc3339(&receipt.handled).is_err()
+            {
+                bail!("monitor handling receipt does not match this delivery");
+            }
+        }
+        Ok(receipt)
+    }
+
+    pub fn handle(&mut self, id: &str, evidence: &str) -> Result<HandlingReceipt> {
+        let item = self.get(id)?;
+        if evidence.trim().is_empty() || evidence.len() > 8000 {
+            bail!("handling needs a disposition of 1 to 8000 bytes");
+        }
+        if let Some(previous) = self.receipt(id)? {
+            if previous.evidence != evidence {
+                bail!("delivery was already handled with a different disposition");
+            }
+            return Ok(previous);
+        }
+        let receipt = HandlingReceipt {
+            delivery: id.to_string(),
+            fingerprint: item.fingerprint,
+            evidence: evidence.to_string(),
+            handled: now(),
+        };
+        self.put(&format!("receipt-{id}.json"), &receipt)?;
+        Ok(receipt)
+    }
+
+    pub fn acked(&self, id: &str) -> Result<bool> {
+        Self::check_id(id)?;
+        let mark = self.read::<Acknowledgement>(&format!("acked-{id}.json"))?;
+        if let Some(mark) = &mark {
+            if self.receipt(id)?.is_none()
+                || mark.fingerprint != self.get(id)?.fingerprint
+                || chrono::DateTime::parse_from_rfc3339(&mark.acknowledged).is_err()
+            {
+                bail!("monitor acknowledgement is missing its matching receipt");
+            }
+        }
+        Ok(mark.is_some())
+    }
+
+    pub fn mark_acknowledged(&mut self, id: &str) -> Result<()> {
+        if self.receipt(id)?.is_none() {
+            bail!("cannot acknowledge a monitor delivery without a handling receipt");
+        }
+        let item = self.get(id)?;
+        self.put(
+            &format!("acked-{id}.json"),
+            &Acknowledgement {
+                fingerprint: item.fingerprint,
+                acknowledged: now(),
+            },
+        )
+    }
+
+    fn scan_id(&self, cursor: u64, next: u64) -> String {
+        fingerprint(&json!([
+            "empty_scan",
+            self.binding.thread_id,
+            self.binding.base_url,
+            self.binding.subscription,
+            cursor,
+            next
+        ]))[7..]
+            .to_string()
+    }
+
+    fn scan_fingerprint(&self, cursor: u64, next: u64, scanned: &str) -> String {
+        fingerprint(&json!({
+            "kind": "empty_filtered_scan",
+            "thread_id": self.binding.thread_id,
+            "base_url": self.binding.base_url,
+            "subscription": self.binding.subscription,
+            "cursor": cursor,
+            "next": next,
+            "observations": [],
+            "scanned": scanned,
+        }))
+    }
+
+    fn scan(&self, id: &str) -> Result<ScanReceipt> {
+        Self::check_id(id)?;
+        let scan = self
+            .read::<ScanReceipt>(&format!("empty-scan-{id}.json"))?
+            .context("monitor empty scan receipt is missing")?;
+        if scan.id != id
+            || scan.cursor >= scan.next
+            || scan.next > MAX_SAFE_CURSOR
+            || self.scan_id(scan.cursor, scan.next) != id
+            || self.scan_fingerprint(scan.cursor, scan.next, &scan.scanned) != scan.fingerprint
+            || chrono::DateTime::parse_from_rfc3339(&scan.scanned).is_err()
+        {
+            bail!("monitor empty scan receipt is inconsistent or has changed");
+        }
+        Ok(scan)
+    }
+
+    fn scan_acknowledged(&self, scan: &ScanReceipt) -> Result<bool> {
+        let mark = self.read::<Acknowledgement>(&format!("scan-acked-{}.json", scan.id))?;
+        if let Some(mark) = &mark {
+            if mark.fingerprint != scan.fingerprint
+                || chrono::DateTime::parse_from_rfc3339(&mark.acknowledged).is_err()
+            {
+                bail!("monitor scan acknowledgement does not match its receipt");
+            }
+        }
+        Ok(mark.is_some())
+    }
+
+    /// Recover an uncommitted scan before pulling again. It may never coexist with a
+    /// pending observation, whose immutable handling receipt remains mandatory.
+    pub fn pending_scan(&self) -> Result<Option<ScanReceipt>> {
+        let mut pending = None;
+        for entry in fs::read_dir(&self.path)? {
+            let name = entry?.file_name();
+            let name = name.to_string_lossy();
+            if let Some(id) = name
+                .strip_prefix("empty-scan-")
+                .and_then(|name| name.strip_suffix(".json"))
+            {
+                let scan = self.scan(id)?;
+                if !self.scan_acknowledged(&scan)? {
+                    if pending.is_some() {
+                        bail!("multiple pending empty scans; refusing to skip one");
+                    }
+                    pending = Some(scan);
+                }
+            }
+        }
+        if pending.is_some() && self.pending()?.is_some() {
+            bail!("empty scan cannot bypass a pending observation");
+        }
+        Ok(pending)
+    }
+
+    /// Persist only a validated empty pull page, before committing its next cursor.
+    pub fn record_scan(&mut self, cursor: u64, next: u64) -> Result<ScanReceipt> {
+        if cursor >= next || next > MAX_SAFE_CURSOR {
+            bail!("empty scan must advance within the safe cursor range");
+        }
+        if self.pending()?.is_some() {
+            bail!("empty scan cannot bypass a pending observation");
+        }
+        let id = self.scan_id(cursor, next);
+        if let Some(pending) = self.pending_scan()? {
+            if pending.id != id {
+                bail!("cannot record another empty scan before acknowledgement");
+            }
+            return Ok(pending);
+        }
+        if self
+            .read::<ScanReceipt>(&format!("empty-scan-{id}.json"))?
+            .is_some()
+        {
+            bail!("source repeated an acknowledged empty scan; reconcile its cursor");
+        }
+        let scanned = now();
+        let scan = ScanReceipt {
+            id,
+            cursor,
+            next,
+            fingerprint: self.scan_fingerprint(cursor, next, &scanned),
+            scanned,
+        };
+        self.put(&format!("empty-scan-{}.json", scan.id), &scan)?;
+        self.scan(&scan.id)
+    }
+
+    pub fn mark_scan_acknowledged(&mut self, id: &str) -> Result<()> {
+        if self.pending()?.is_some() {
+            bail!("empty scan cannot bypass a pending observation");
+        }
+        let scan = self.scan(id)?;
+        if let Some(pending) = self.pending_scan()? {
+            if pending.id != scan.id {
+                bail!("cannot acknowledge a different pending scan");
+            }
+        }
+        self.put(
+            &format!("scan-acked-{id}.json"),
+            &Acknowledgement {
+                fingerprint: scan.fingerprint,
+                acknowledged: now(),
+            },
+        )
+    }
+}
+
+#[cfg(test)]
+#[allow(clippy::unwrap_used)]
+mod tests {
+    use super::*;
+
+    fn binding() -> Binding {
+        Binding {
+            thread_id: "thread-one".to_string(),
+            owner: "actor-one".to_string(),
+            session_nonce: "live-session-one".to_string(),
+            base_url: "https://example.com".to_string(),
+            subscription: "one".to_string(),
+        }
+    }
+
+    fn event() -> Value {
+        json!({"specversion":"1.0","source":"monitor:test","id":"event-7",
+            "sequence":"00000000000000000007","type":"com.example.changed","time":"2026-10-11T00:00:00Z",
+            "tier":"measured","origin":"probe","verified":"machine_verified","horizon":"event","actor":"system:test",
+            "data":{"provenance":{"tier":"measured","origin":"probe","verification":"machine_verified","actor":"system:test"}}})
+    }
+
+    #[test]
+    fn empty_scan_receipt_is_durable_exclusive_and_bound_to_its_source() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("private");
+        let mut journal = Journal::open(&path, binding()).unwrap();
+        for (cursor, next) in [(1, 1), (8, 1), (1, MAX_SAFE_CURSOR + 1)] {
+            assert!(journal.record_scan(cursor, next).is_err());
+        }
+        let scan = journal.record_scan(1, 7).unwrap();
+        assert_eq!(journal.record_scan(1, 7).unwrap(), scan);
+        assert!(journal.record_scan(1, 8).is_err());
+        assert!(journal.add(event(), 8).is_err());
+        assert!(journal.pending().unwrap().is_none());
+        drop(journal);
+
+        let mut rearmed = binding();
+        rearmed.owner = "new-client".to_string();
+        rearmed.session_nonce = "new-explicit-activation".to_string();
+        let mut journal = Journal::rearm(&path, rearmed).unwrap();
+        assert_eq!(journal.pending_scan().unwrap().unwrap(), scan);
+        assert!(journal.mark_scan_acknowledged(&"0".repeat(64)).is_err());
+        journal.mark_scan_acknowledged(&scan.id).unwrap();
+        assert!(journal.pending_scan().unwrap().is_none());
+        assert!(
+            journal.record_scan(1, 7).is_err(),
+            "acked scans cannot replay"
+        );
+
+        let item = journal.add(event(), 8).unwrap();
+        assert!(
+            journal.record_scan(7, 8).is_err(),
+            "pending event cannot be skipped"
+        );
+        journal
+            .handle(&item.id, "actual event disposition")
+            .unwrap();
+        assert!(
+            journal.record_scan(7, 8).is_err(),
+            "event must also be source-acked first"
+        );
+        journal.mark_acknowledged(&item.id).unwrap();
+        assert!(journal.record_scan(8, 10).is_ok());
+    }
+
+    #[test]
+    fn tampered_scan_receipt_or_ack_cannot_be_recovered() {
+        for kind in ["empty-scan", "scan-acked"] {
+            let dir = tempfile::tempdir().unwrap();
+            let path = dir.path().join("private");
+            let mut journal = Journal::open(&path, binding()).unwrap();
+            let scan = journal.record_scan(1, 8).unwrap();
+            journal.mark_scan_acknowledged(&scan.id).unwrap();
+            let file = path.join(format!("{kind}-{}.json", scan.id));
+            let mut data: Value = serde_json::from_slice(&fs::read(&file).unwrap()).unwrap();
+            data["fingerprint"] = json!("sha256:forged");
+            fs::write(file, serde_json::to_vec(&data).unwrap()).unwrap();
+            assert!(journal.pending_scan().is_err());
+            drop(journal);
+            assert!(Journal::rearm(&path, binding()).is_err());
+        }
+    }
+
+    #[test]
+    fn durable_delivery_and_receipt_survive_reopen_without_ack_on_enqueue() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("private");
+        let id;
+        {
+            let mut journal = Journal::open(&path, binding()).unwrap();
+            let item = journal.add(event(), 8).unwrap();
+            id = item.id;
+            journal.mark_queued(&id).unwrap();
+            assert!(journal.queued(&id).unwrap());
+            assert!(journal.receipt(&id).unwrap().is_none());
+            assert!(!journal.acked(&id).unwrap());
+            assert!(journal.mark_acknowledged(&id).is_err());
+            assert!(
+                Journal::open(&path, binding()).is_err(),
+                "one lock owner at a time"
+            );
+        }
+        {
+            let mut journal = Journal::open(&path, binding()).unwrap();
+            assert_eq!(journal.pending().unwrap().unwrap().id, id);
+            assert!(journal.queued(&id).unwrap());
+            let receipt = journal.handle(&id, "record:own-disposition").unwrap();
+            assert_eq!(
+                journal.handle(&id, "record:own-disposition").unwrap(),
+                receipt
+            );
+            assert!(journal.handle(&id, "different disposition").is_err());
+            assert!(
+                !journal.acked(&id).unwrap(),
+                "handling is independent of network acknowledgement"
+            );
+        }
+        let mut journal = Journal::open(&path, binding()).unwrap();
+        assert!(journal.receipt(&id).unwrap().is_some());
+        journal.mark_acknowledged(&id).unwrap();
+        assert!(journal.pending().unwrap().is_none());
+        assert!(
+            journal.add(event(), 8).is_err(),
+            "acknowledged identities cannot replay silently"
+        );
+    }
+
+    #[test]
+    fn deduplicates_delivery_metadata_and_rejects_changed_content_or_second_pending() {
+        let dir = tempfile::tempdir().unwrap();
+        let mut journal = Journal::open(&dir.path().join("private"), binding()).unwrap();
+        let first = journal.add(event(), 8).unwrap();
+        let mut retry = event();
+        retry["redelivered"] = json!(true);
+        assert_eq!(journal.add(retry, 8).unwrap(), first);
+        let mut changed = event();
+        changed["data"]["forged"] = json!(true);
+        assert!(journal.add(changed, 8).is_err());
+        let mut another = event();
+        another["id"] = json!("another-event");
+        assert!(journal.add(another, 8).is_err());
+        assert_eq!(journal.pending().unwrap().unwrap(), first);
+    }
+
+    #[test]
+    fn old_owner_session_or_source_cannot_reattach_existing_journal() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("private");
+        drop(Journal::open(&path, binding()).unwrap());
+        for field in [
+            "thread_id",
+            "owner",
+            "session_nonce",
+            "base_url",
+            "subscription",
+        ] {
+            let mut changed = serde_json::to_value(binding()).unwrap();
+            changed[field] = json!("different");
+            assert!(Journal::open(&path, serde_json::from_value(changed).unwrap()).is_err());
+        }
+        assert!(Journal::open(&path, binding()).is_ok());
+    }
+
+    #[test]
+    fn explicit_same_thread_rearm_retains_receipts_and_reissues_only_unhandled_metadata() {
+        for handled in [false, true] {
+            let dir = tempfile::tempdir().unwrap();
+            let path = dir.path().join("private");
+            let mut journal = Journal::open(&path, binding()).unwrap();
+            let item = journal.add(event(), 8).unwrap();
+            journal.mark_queued(&item.id).unwrap();
+            if handled {
+                journal
+                    .handle(&item.id, "record:durable-before-crash")
+                    .unwrap();
+            }
+            let mut new_binding = binding();
+            new_binding.owner = "new-attending-client".to_string();
+            new_binding.session_nonce = "new-explicit-activation".to_string();
+            assert!(
+                Journal::rearm(&path, new_binding.clone()).is_err(),
+                "cannot steal a live lock"
+            );
+            drop(journal);
+            let mut restarted = Journal::rearm(&path, new_binding.clone()).unwrap();
+            assert_eq!(restarted.header(), &new_binding);
+            assert_eq!(
+                restarted.pending().unwrap().unwrap(),
+                item,
+                "delivery identity survives explicit rearm"
+            );
+            assert_eq!(restarted.receipt(&item.id).unwrap().is_some(), handled);
+            assert_eq!(
+                restarted.queued(&item.id).unwrap(),
+                handled,
+                "unhandled notifications need the new activation reference"
+            );
+            assert!(!restarted.acked(&item.id).unwrap());
+            if handled {
+                restarted.mark_acknowledged(&item.id).unwrap();
+                assert!(restarted.pending().unwrap().is_none());
+            }
+        }
+    }
+
+    #[test]
+    fn explicit_rearm_cannot_change_thread_or_source() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("private");
+        drop(Journal::open(&path, binding()).unwrap());
+        for field in ["thread_id", "base_url", "subscription"] {
+            let mut changed = serde_json::to_value(binding()).unwrap();
+            changed[field] = json!("different");
+            assert!(Journal::rearm(&path, serde_json::from_value(changed).unwrap()).is_err());
+        }
+    }
+
+    #[test]
+    fn tampered_delivery_receipt_or_acknowledgement_cannot_advance() {
+        for kind in ["delivery", "receipt", "acked"] {
+            let dir = tempfile::tempdir().unwrap();
+            let path = dir.path().join("private");
+            let mut journal = Journal::open(&path, binding()).unwrap();
+            let item = journal.add(event(), 8).unwrap();
+            journal.handle(&item.id, "attended").unwrap();
+            journal.mark_acknowledged(&item.id).unwrap();
+            let file = path.join(format!("{kind}-{}.json", item.id));
+            let mut data: Value = serde_json::from_slice(&fs::read(&file).unwrap()).unwrap();
+            data["fingerprint"] = json!("sha256:forged");
+            fs::write(file, serde_json::to_vec(&data).unwrap()).unwrap();
+            assert!(journal.acked(&item.id).is_err());
+            assert!(journal.pending().is_err());
+            drop(journal);
+            assert!(Journal::open(&path, binding()).is_err());
+        }
+    }
+
+    #[test]
+    fn fingerprint_is_canonical_and_invalid_identifiers_cannot_escape_directory() {
+        let a: Value = serde_json::from_str(r#"{"z":{"b":2,"a":1},"a":[1,2]}"#).unwrap();
+        let b: Value = serde_json::from_str(r#"{"a":[1,2],"z":{"a":1,"b":2}}"#).unwrap();
+        assert_eq!(fingerprint(&a), fingerprint(&b));
+        let dir = tempfile::tempdir().unwrap();
+        let mut journal = Journal::open(&dir.path().join("private"), binding()).unwrap();
+        assert!(journal.get("../../other").is_err());
+        let item = journal.add(event(), 8).unwrap();
+        assert!(journal.handle(&item.id, "  ").is_err());
+        assert!(journal.handle(&item.id, &"x".repeat(8001)).is_err());
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn directory_and_records_are_private_and_symlinks_are_refused() {
+        use std::os::unix::fs::MetadataExt;
+        use std::os::unix::fs::PermissionsExt;
+        use std::os::unix::fs::symlink;
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("private");
+        let mut journal = Journal::open(&path, binding()).unwrap();
+        let item = journal.add(event(), 8).unwrap();
+        assert_eq!(fs::metadata(&path).unwrap().mode() & 0o777, 0o700);
+        for name in [
+            "worker.lock".to_string(),
+            "binding.json".to_string(),
+            format!("delivery-{}.json", item.id),
+        ] {
+            assert_eq!(fs::metadata(path.join(name)).unwrap().mode() & 0o777, 0o600);
+        }
+        let receipt = path.join(format!("receipt-{}.json", item.id));
+        symlink(path.join("binding.json"), &receipt).unwrap();
+        assert!(journal.handle(&item.id, "attended").is_err());
+        fs::remove_file(receipt).unwrap();
+        drop(journal);
+        let link = dir.path().join("linked");
+        symlink(&path, &link).unwrap();
+        assert!(Journal::open(&link, binding()).is_err());
+        fs::set_permissions(&path, fs::Permissions::from_mode(0o755)).unwrap();
+        assert!(Journal::open(&path, binding()).is_err());
+    }
+}
