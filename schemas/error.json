{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://mentu.ai/schemas/monitor-protocol/0.1/error.json",
 "title": "error",
 "description": "The REST error body. Over JSON-RPC the same failure travels as `error{code: <numeric>, message, data: <this object>}` (spec/02-methods.md).",
 "type": "object",
 "properties": {
  "code": {
   "type": "string",
   "enum": [
    "INVALID_FILTER",
    "UNKNOWN_VOCABULARY",
    "TIER_NOT_ASSERTABLE",
    "PROVENANCE_CEILING",
    "INVALID",
    "CAPABILITY_MISSING",
    "UNAUTHORIZED",
    "NOT_FOUND",
    "DUPLICATE",
    "CURSOR_BACKWARDS",
    "CURSOR_EXPIRED",
    "LEASE_HELD",
    "LEASE_LOST",
    "EVIDENCE_REQUIRED",
    "OVER_BUDGET",
    "ORIGIN_REFUSED",
    "TOO_LARGE",
    "UNAVAILABLE"
   ]
  },
  "error": {
   "type": "string"
  },
  "done": {
   "type": "array",
   "description": "what was applied before the refusal (Atrio §5)"
  }
 },
 "required": [
  "code",
  "error"
 ],
 "additionalProperties": true
}
